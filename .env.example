# --- LLM backend for the video -> features extractor (src/sip/extract.py) ---
# Choose a backend with SIP_LLM and provide the matching key. WITHOUT a key the
# extractor still runs transcript-only (Whisper) and feeds Model A — it never fails.
SIP_LLM=deepseek           # deepseek | haiku | none
DEEPSEEK_API_KEY=          # https://platform.deepseek.com  (OpenAI-compatible, final product)
ANTHROPIC_API_KEY=         # https://console.anthropic.com  (used when SIP_LLM=haiku)

# --- optional runtime knobs ---
# SIP_DEVICE=cpu           # cpu | mps  (device for the BGE text embedding)
# SIP_WHISPER=base         # faster-whisper model size (base | small | medium)
# SIP_LLM_MODEL=           # override the model id for the chosen backend

# Google Gemini (AI Studio) — recommended LLM backend for feature extraction
GEMINI_API_KEY=
# SIP_LLM=gemini

# Local LLM (no keys, offline): install ollama, then `ollama serve` + `ollama pull llama3.2:3b`
# SIP_LLM=ollama
# SIP_LLM_MODEL=llama3.2:3b   # or phi4 for higher quality (slower)
